[Unit]
Description=ZED Zero-day Endpoint Detection & Response Daemon
After=network.target

[Service]
Type=simple
User=anuj
WorkingDirectory=/home/anuj/Desktop/ZED
ExecStart=/home/anuj/Desktop/ZED/.venv/bin/python /home/anuj/Desktop/ZED/run_server.py
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=HOST=0.0.0.0
Environment=PORT=8000

# Security Sandboxing for Service
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/anuj/Desktop/ZED

[Install]
WantedBy=multi-user.target
